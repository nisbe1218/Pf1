@startuml Architecture5Couches
' Architecture réelle du projet — vérifiée dans le code source
' Frontend: React 18 + MUI | Backend: Django 6 + DRF | Async: Celery + Redis
' LLM: Ollama/Qwen 2.5 | BD: PostgreSQL
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ranksep 30
skinparam nodesep 20
skinparam defaultFontSize 12

skinparam package {
  BorderColor #64748B
  FontColor #0F172A
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
}

' ═══════════════════════════════════════════════
' COUCHE 1 — INTERFACE UTILISATEUR
' ═══════════════════════════════════════════════
package "Couche 1 — Interface Utilisateur  (React 18 + Material-UI 5)" #E8F4FD {
  component "Pages\n/dashboard /patients\n/modele-ai /monitor\n/preprocessing /profil" as Pages
  component "Composants communs\nAppSidebar · ProtectedRoute\nNotesFab" as Comp
  component "Contextes\nAuthContext · LanguageContext" as Ctx
  component "Service HTTP\naxios — JWT Bearer auto" as Http
}

' ═══════════════════════════════════════════════
' COUCHE 2 — API REST
' ═══════════════════════════════════════════════
package "Couche 2 — API REST  (Django 6 + Django REST Framework)" #FEF3C7 {
  component "Auth API\nPOST /api/auth/login/\nGET  /api/auth/profil/\nGET  /api/auth/utilisateurs/" as AuthAPI
  component "Patients API\nCRUD /api/patients/\nPOST /api/patients/preprocess/analyze/\nGET  /api/patients/preprocess/{id}/status/" as PatAPI
  component "Prédictions API\nGET  /api/predictions/patient/{id}/mortalite/\nPOST /api/predictions/patient/{id}/mortalite/" as PredAPI
  component "Audit API\nGET /api/audit/logs/\nGET /api/monitor/patient-events/" as AuditAPI
}

' ═══════════════════════════════════════════════
' COUCHE 3 — LOGIQUE MÉTIER
' ═══════════════════════════════════════════════
package "Couche 3 — Logique Métier  (Apps Django)" #DCFCE7 {
  component "App users\nUtilisateur · Role\nJWT enrichi (email, rôle)\nPermissions: IsAdminOrChefService\nCanViewPatients" as AppUsers
  component "App patients\nPatient (162 champs)\nPatientFormTemplate\nPreprocessValidationRequest\nDynamicColumnRequest" as AppPatients
  component "App predictions\nSVM Linéaire 32 features\nExtraction features patient\nCalibration + niveau risque" as AppPred
  component "App audit\nAuditLog · HiddenAuditLog\nTraçabilité IP + acteur" as AppAudit
}

' ═══════════════════════════════════════════════
' COUCHE 4 — SERVICES ASYNCHRONES & IA
' ═══════════════════════════════════════════════
package "Couche 4 — Services Asynchrones & IA" #FCE7F3 {
  component "Celery Worker\nTâche: analyze_preprocess_async\nPipeline: profiling → chunks\n→ RAG → LLM → KNN → rapport" as Celery
  component "Ollama / Qwen 2.5\nAnalyse LLM des données\nIssues · Corrections · Recommendations\nConfidence score · Risk level" as LLM
  component "Modèles ML (joblib)\nSVM mortalité 1 an\nRandom Forest / XGBoost\nKaplan-Meier (survie)" as ML
  component "Redis\nBroker Celery\nCache sessions preprocessing\nredis://redis:6379/0" as Redis
}

' ═══════════════════════════════════════════════
' COUCHE 5 — PERSISTANCE
' ═══════════════════════════════════════════════
package "Couche 5 — Persistance  (PostgreSQL)" #F3E8FF {
  component "Tables utilisateurs\nrole · utilisateur" as TbUsers
  component "Tables patients\npatient (162 champs)\npatientformtemplate\npatientformfield\npreprocessvalidationrequest\ndynamiccolumnrequest" as TbPat
  component "Tables audit\nauditlog · hiddenauditlog" as TbAudit
}

' ═══════════════════════════════════════════════
' FLUX VERTICAUX
' ═══════════════════════════════════════════════
Pages --> AuthAPI
Pages --> PatAPI
Pages --> PredAPI
Pages --> AuditAPI
Comp --> Ctx
Http --> AuthAPI
Http --> PatAPI
Http --> PredAPI
Http --> AuditAPI

AuthAPI --> AppUsers
PatAPI  --> AppPatients
PredAPI --> AppPred
AuditAPI --> AppAudit

AppPatients --> Celery : dispatch async
Celery --> LLM : HTTP Ollama
Celery --> Redis : cache session
AppPred --> ML : load joblib

AppUsers --> TbUsers
AppPatients --> TbPat
AppAudit --> TbAudit
Celery --> TbPat : intégration patients

@enduml
