@startuml DiagrammeEntiteRelation
' Diagramme Entité-Relation — basé sur backend/users/models.py,
' backend/patients/models.py, backend/audit/models.py (vérification directe du code)
top to bottom direction
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam ranksep 45
skinparam nodesep 30
!define RECTANGLE class

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  ArrowColor #64748B
  FontColor #0F172A
}
skinparam package {
  BorderColor #CBD5E1
  FontColor #0F172A
  BackgroundColor #F8FAFC
}

' ===== SÉCURITÉ & ACCÈS =====
package "Sécurité & Accès" #FCE7F3 {
  RECTANGLE Role {
    +id : int
    +nom : enum(super_admin, chef_service,\n             professeur, resident)
  }

  RECTANGLE Utilisateur {
    +id : int
    +email : string  <<unique>>
    +nom : string
    +prenom : string
    +telephone : string
    +personal_notes : text
    +role_id : FK → Role
    +is_active : bool
    +is_staff : bool
    +date_creation : datetime
  }
}

' ===== PATIENTS =====
package "Dossier Patient" #FEF3C7 {
  RECTANGLE Patient {
    +id : int
    +id_patient : string  <<auto PAT-XXXXXX>>
    +id_enregistrement_source : string
    +nom, prenom : string
    +age : int
    +sexe : enum(M, F, O)
    +maladie : string
    +date_naissance, date_admission : date
    +statut_inclusion : string
    +statut_consentement : string
    +icc_charlson : string
    --
    +demographie_data : JSONField
    +irc_data : JSONField
    +comorbidite_data : JSONField
    +presentation_data : JSONField
    +biologie_data : JSONField
    +imagerie_data : JSONField
    +dialyse_data : JSONField
    +qualite_data : JSONField
    +complication_data : JSONField
    +traitement_data : JSONField
    +devenir_data : JSONField
    +extra_data : JSONField
    --
    +created_at, updated_at : datetime
  }
}

' ===== FORMULAIRES DYNAMIQUES =====
package "Formulaires dynamiques" #DBEAFE {
  RECTANGLE PatientFormTemplate {
    +id : int
    +name : string
    +source_file_name : string
    +sheet_name : string
    +imported_at : datetime
  }

  RECTANGLE PatientFormField {
    +id : int
    +template_id : FK → PatientFormTemplate
    +key : string
    +label : string
    +field_type : enum(text_short, text_long,\n  single_choice, multiple_choice,\n  date, integer, decimal, boolean, auto)
    +order : int
    +choices : JSONField
    +source_hint : string
    +is_required : bool
    <<unique (template, key)>>
  }
}

' ===== PREPROCESSING & VALIDATION =====
package "Prétraitement & Validation" #DCFCE7 {
  RECTANGLE PreprocessValidationRequest {
    +id : int
    +session_id : string
    +source : enum(corrected, original)
    +source_file_name : string
    +submitted_by_id : FK → Utilisateur
    +submitted_at : datetime
    +status : enum(pending, approved, rejected)
    +reviewed_by_id : FK → Utilisateur
    +reviewed_at : datetime
    +comment : text
    +rows_count : int
    +columns_count : int
    +quality_score : float
  }

  RECTANGLE DynamicColumnRequest {
    +id : int
    +action : enum(add, delete)
    +column_key : string
    +column_label : string
    +field_type : string
    +submitted_by_id : FK → Utilisateur
    +submitted_at : datetime
    +status : enum(pending, approved, rejected)
    +reviewed_by_id : FK → Utilisateur
    +reviewed_at : datetime
    +comment : text
  }
}

' ===== TRAÇABILITÉ =====
package "Traçabilité" #FFF7ED {
  RECTANGLE AuditLog {
    +id : int
    +utilisateur_id : FK → Utilisateur
    +action : text
    +entite : string
    +entite_id : int
    +details : text
    +adresse_ip : string
    +date : datetime
  }

  RECTANGLE HiddenAuditLog {
    +id : int
    +user_id : FK → Utilisateur
    +audit_log_id : FK → AuditLog
    +hidden_at : datetime
    <<unique (user, audit_log)>>
  }
}

' ===== RELATIONS =====
Role "1" -- "0..*" Utilisateur : attribué à

Utilisateur "1" -- "0..*" PreprocessValidationRequest : soumet >
Utilisateur "1" -- "0..*" PreprocessValidationRequest : révise >
Utilisateur "1" -- "0..*" DynamicColumnRequest : soumet >
Utilisateur "1" -- "0..*" DynamicColumnRequest : révise >
Utilisateur "1" -- "0..*" AuditLog : génère >
Utilisateur "1" -- "0..*" HiddenAuditLog : masque >

PatientFormTemplate "1" -- "1..*" PatientFormField : contient >

AuditLog "1" -- "0..*" HiddenAuditLog : masqué par >

' Aide à l'agencement
Role -[hidden]right-> PatientFormTemplate
Utilisateur -[hidden]down-> Patient
Patient -[hidden]right-> PatientFormTemplate
PatientFormTemplate -[hidden]down-> PreprocessValidationRequest
AuditLog -[hidden]right-> HiddenAuditLog

@enduml
