@startuml SequenceAuthJWT
' Séquence 1 — Authentification JWT
' Basé sur : frontend/src/context/AuthContext.js
'             frontend/src/services/api/axios.js
'             backend/users/views.py (LoginView / TokenObtainPairView)
'             backend/users/serializers.py (CustomTokenSerializer)
skinparam shadowing false
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceArrowThickness 1.5
skinparam sequenceBoxBorderColor #9CA3AF
skinparam participantBorderColor #374151
skinparam participantBackgroundColor #FFFFFF
skinparam participantFontColor #0F172A
skinparam noteBorderColor #D97706
skinparam noteBackgroundColor #FEF9C3
skinparam lifelineBorderColor #9CA3AF
skinparam activationBorderColor #374151

actor "Utilisateur" as User
participant "Frontend\n(React / AuthContext)" as FE #E8F4FD
participant "Backend\n(Django / LoginView)" as BE #FEF3C7
database "PostgreSQL\n(Utilisateur)" as DB #DCFCE7

== Saisie des identifiants ==

User -> FE : Saisir email + mot de passe\n(formulaire Login.js)
activate FE

FE -> BE : POST /api/auth/login/\n{ email, password }
activate BE

BE -> DB : SELECT utilisateur WHERE email = ?
activate DB
DB --> BE : Utilisateur (hash mot de passe, role_id)
deactivate DB

BE -> BE : check_password(password, hash)\n[AbstractBaseUser — bcrypt]
alt Identifiants invalides
    BE --> FE : 401 Unauthorized\n{ detail: "Identifiants incorrects" }
    FE --> User : Afficher message d'erreur
else Identifiants valides
    BE -> BE : Générer JWT (CustomTokenSerializer)\nPayload enrichi :\n{ id, email, nom, prenom,\n  telephone, role, exp, jti }
    note right of BE
      access token : exp = now + 8h
      refresh token : exp = now + 7j
    end note
    BE --> FE : 200 OK\n{ access, refresh }
    deactivate BE

    == Stockage & Initialisation session ==

    FE -> FE : localStorage.setItem('access_token', access)\nlocalStorage.setItem('refresh_token', refresh)
    FE -> FE : jwtDecode(access)\n→ extraire payload
    FE -> FE : normalizeUser(payload)\n→ { id, email, nom, prenom, role }
    FE -> FE : setUser(normalizedUser)\n→ AuthContext mis à jour

    FE --> User : Redirection vers /dashboard
end
deactivate FE

== Requêtes authentifiées suivantes ==

User -> FE : Navigation (ex: /patients)
activate FE
FE -> BE : GET /api/patients/\nAuthorization: Bearer <access_token>
activate BE
note right of BE
  Interceptor axios.js injecte
  automatiquement le header
  Bearer à chaque requête
end note
BE -> BE : Vérifier JWT (SimpleJWT)\nDéchiffrer payload, vérifier exp
BE -> DB : Charger Utilisateur (id du token)
activate DB
DB --> BE : Utilisateur authentifié + rôle
deactivate DB
BE -> BE : CanViewPatients.has_permission()\n→ autorisation vérifiée
BE --> FE : 200 OK + données
deactivate BE
FE --> User : Afficher page
deactivate FE

@enduml
