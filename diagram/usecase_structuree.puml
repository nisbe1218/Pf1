@startuml
' Diagramme corrigé — basé sur l'implémentation réelle du code (App.js, Dashboard.js,
' PatientsManagement.js, patients/views.py, audit/views.py, users/views.py)
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam backgroundColor white
skinparam linetype ortho
skinparam ranksep 40
skinparam nodesep 28

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #374151
  FontColor #111827
}

skinparam package {
  BorderColor #9CA3AF
  FontColor #111827
}

skinparam actor {
  FontColor #111827
}

' ===== ACTEURS =====
actor "Utilisateur" as U #E5E7EB
actor "Super Administrateur" as SA #FBCFE8
actor "Chef de Service" as CS #BFDBFE
actor "Professeur" as PR #BBF7D0
actor "Résident" as RS #FDE68A

SA --|> U
CS --|> U
PR --|> U
RS --|> U

U -[hidden]down-> SA
SA -[hidden]down-> CS
CS -[hidden]down-> PR
PR -[hidden]down-> RS

' ===== ADMINISTRATION & ACCÈS =====
rectangle "Administration & accès" as ADM #FCE7F3 {
  usecase "S'authentifier" as UC1
  usecase "Gérer les comptes utilisateurs" as UC2
  usecase "Consulter le journal de traçabilité" as UC3
  usecase "Superviser la sécurité et les accès" as UC4
}

note bottom of UC2
  Chef de Service : gère uniquement
  les comptes Professeur et Résident
  (pas les comptes Admin)
end note

' ===== DONNÉES MÉDICALES =====
rectangle "Gestion des données médicales" as DATA #DBEAFE {
  usecase "Importer les données médicales" as UC5
  usecase "Valider / purger les données importées" as UC6
  usecase "Gérer les colonnes dynamiques" as UC7

  UC5 --> UC6 : <<include>>
}

' ===== DOSSIERS & SURVEILLANCE PATIENTS =====
rectangle "Dossiers & surveillance patients" as PAT #FEF3C7 {
  usecase "Consulter les dossiers patients" as UC8
  usecase "Suivre les patients" as UC9
  usecase "Consulter l'activité récente" as UC10
}

note bottom of UC10
  Professeur / Résident : voient
  l'activité mais pas l'auteur
  de chaque action
end note

' ===== ANALYSE & IA =====
rectangle "Analyse & IA" as AI #DCFCE7 {
  usecase "Faire des prédictions via modèles IA" as UC11
  usecase "Analyser les modèles prédictifs" as UC12
  usecase "Visualiser les statistiques\ndu tableau de bord" as UC13
}

' ===== PROFIL PERSONNEL =====
rectangle "Profil personnel" as PERSO #FFF7ED {
  usecase "Consulter / modifier son profil" as UC14
}

' Aide au placement vertical des blocs
UC1 -[hidden]down-> UC5
UC5 -[hidden]down-> UC8
UC8 -[hidden]down-> UC11
UC11 -[hidden]down-> UC14

' ===== RELATIONS =====

' Super Administrateur — accès total
SA --> UC1
SA --> UC2
SA --> UC3
SA --> UC4
SA --> UC5
SA --> UC6
SA --> UC7
SA --> UC8
SA --> UC9
SA --> UC10
SA --> UC11
SA --> UC12
SA --> UC13
SA --> UC14

' Chef de Service — tout sauf gestion des comptes Admin
CS --> UC1
CS --> UC2
CS --> UC3
CS --> UC4
CS --> UC5
CS --> UC6
CS --> UC7
CS --> UC8
CS --> UC9
CS --> UC10
CS --> UC11
CS --> UC12
CS --> UC13
CS --> UC14

' Professeur — patients, IA, activité (sans gestion ni import)
PR --> UC1
PR --> UC8
PR --> UC9
PR --> UC10
PR --> UC11
PR --> UC12
PR --> UC14

' Résident — mêmes droits que Professeur
RS --> UC1
RS --> UC8
RS --> UC9
RS --> UC10
RS --> UC11
RS --> UC12
RS --> UC14

@enduml
