\contentsline {figure}{\numberline {5.1}{\ignorespaces AUC-ROC and PR-AUC comparison across all evaluated models (HD-478 cohort, 10-fold stratified CV). SVM achieves the highest scores on both metrics.}}{68}{figure.caption.46}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces ROC curves for all nine ML models evaluated on the HD-478 cohort (stratified 10-fold CV). The SVM linear model achieves the highest AUC-ROC = 0.826.}}{68}{figure.caption.47}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Train-test AUC gap for each evaluated model. A gap $< 0.1$ (dashed red line) indicates no significant overfitting. The SVM linear model achieves the lowest gap (0.047), confirming strong generalization on the 478-patient cohort.}}{69}{figure.caption.48}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Multi-metric radar chart comparing AUC-ROC, PR-AUC, F1, Brier Score, and Recall across all evaluated models.}}{69}{figure.caption.49}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Calibration curves (reliability diagrams) before and after isotonic calibration for the SVM model. After calibration, predicted probabilities closely track the observed mortality fraction.}}{70}{figure.caption.50}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Confusion matrices for the top three models (SVM, XGBoost, Gradient Boosting) on the test set. True positives (correctly identified deaths) are shown in the lower-right cell.}}{70}{figure.caption.51}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Precision-Recall curves for all evaluated models. PR-AUC is the primary metric used for model selection given the class imbalance (80.1\% vs 19.9\%).}}{71}{figure.caption.52}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Boxplot of AUC-ROC scores across 10 stratified cross-validation folds for each model, illustrating variance and stability of model performance.}}{71}{figure.caption.53}%
